export ZSH="$HOME/.oh-my-zsh"
export LANG="${LANG:-C.UTF-8}"
[[ "$LANG" = "C" ]] && export LANG="C.UTF-8"
export LC_CTYPE="${LC_CTYPE:-C.UTF-8}"
ZSH_THEME="agnoster"
plugins=(git)

if [[ -s "$ZSH/oh-my-zsh.sh" ]]; then
  source "$ZSH/oh-my-zsh.sh"
fi

export EDITOR="vim"
export VISUAL="vim"
export PAGER="less"
path=("$HOME/.local/bin" "$HOME/bin" $path)
typeset -U path PATH
